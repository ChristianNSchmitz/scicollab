# Copy to .env.local and fill in. Leave the Supabase lines empty to run on the
# seeded in-memory demo store, which needs nothing else.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Sign-up, OpenAlex sync, account deletion. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Access ───────────────────────────────────────────────────────────────
# When set, sign-up requires this code.
SCICOLLAB_INVITE_CODE=
# Password for the accounts created by scripts/seed-demo.mjs.
SCICOLLAB_SEED_PASSWORD=

# ── OpenAlex sync ────────────────────────────────────────────────────────
# Protects /api/cron/openalex; without it the route refuses everything.
CRON_SECRET=
# Optional: a larger OpenAlex allowance.
OPENALEX_API_KEY=
# Optional: a contact address, which OpenAlex serves from its faster pool.
OPENALEX_MAILTO=
# Optional: hours between syncs (default 12).
SCICOLLAB_SYNC_INTERVAL_HOURS=
# Optional: 1 turns off the in-process sync timer (instrumentation.ts).
SCICOLLAB_DISABLE_SYNC_TIMER=

# ── Contact form ─────────────────────────────────────────────────────────
# Signs the ALTCHA challenges. Without it the captcha refuses every
# submission in production; on a laptop an ephemeral secret is used.
ALTCHA_HMAC_SECRET=
# Brevo → SMTP & API → API keys. Without the three below nothing is sent and
# the form says so rather than dropping the message.
BREVO_API_KEY=
# A sender address verified in Brevo.
CONTACT_FROM_EMAIL=
# The weekly notification digest (/api/cron/digest) uses BREVO_API_KEY and
# CONTACT_FROM_EMAIL too. The public address of the site, for links in it:
SCICOLLAB_SITE_URL=
# Who receives the messages; comma-separated for several. Deliberately not in
# the code, which is mirrored publicly.
CONTACT_TO_EMAIL=

# ── Demo mode ────────────────────────────────────────────────────────────
# 1 forces the in-memory store even when Supabase is configured.
SCICOLLAB_DEMO=
# 1 hides the yellow "preview build" banner.
SCICOLLAB_HIDE_DEMO_NOTICE=
