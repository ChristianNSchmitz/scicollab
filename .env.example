# Copy to .env.local and fill in. Leave the Supabase lines empty to run on the
# seeded in-memory demo store, which needs nothing else.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Sign-up, OpenAlex sync, account deletion. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Access ───────────────────────────────────────────────────────────────
# When set, sign-up requires this code.
SCICOLLAB_INVITE_CODE=
# Password for the accounts created by scripts/seed-demo.mjs.
SCICOLLAB_SEED_PASSWORD=

# ── OpenAlex sync ────────────────────────────────────────────────────────
# Protects /api/cron/openalex; without it the route refuses everything.
CRON_SECRET=
# Optional: a larger OpenAlex allowance.
OPENALEX_API_KEY=
# Optional: a contact address, which OpenAlex serves from its faster pool.
OPENALEX_MAILTO=
# Optional: hours between syncs (default 12).
SCICOLLAB_SYNC_INTERVAL_HOURS=
# Optional: 1 turns off the in-process sync timer (instrumentation.ts).
SCICOLLAB_DISABLE_SYNC_TIMER=

# ── Demo mode ────────────────────────────────────────────────────────────
# 1 forces the in-memory store even when Supabase is configured.
SCICOLLAB_DEMO=
# 1 hides the yellow "preview build" banner.
SCICOLLAB_HIDE_DEMO_NOTICE=
